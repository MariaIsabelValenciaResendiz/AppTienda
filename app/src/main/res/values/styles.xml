<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Nova.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nova_surface</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="backgroundTint">@color/nova_action_orange</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="iconTint">@color/nova_surface</item>
    </style>

    <style name="Widget.Nova.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nova_surface</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="backgroundTint">@color/nova_petroleum_green</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
    </style>

    <style name="Widget.Nova.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nova_petroleum_green</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="backgroundTint">@color/nova_surface</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="strokeColor">@color/nova_petroleum_green</item>
        <item name="strokeWidth">@dimen/border_width</item>
    </style>

    <style name="Widget.Nova.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/minimum_touch_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nova_text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="Widget.Nova.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/nova_surface</item>
        <item name="boxStrokeColor">@color/nova_petroleum_green</item>
        <item name="hintTextColor">@color/nova_text_secondary</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_medium</item>
    </style>

</resources>