<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base de toda la app: hereda de Material Components
         IMPORTANTE: cambia "Theme.NovaTienda" de abajo por el nombre
         EXACTO que tenga tu android:theme en AndroidManifest.xml -->
    <style name="Theme.NovaTienda" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_accion</item>
        <item name="colorPrimaryDark">@color/color_accion</item>
        <item name="colorAccent">@color/color_confianza</item>
        <item name="android:windowBackground">@color/color_fondo</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/color_fondo</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- ======================= TIPOGRAFÍA (según PDF) =======================
         Títulos: 23-31sp | Cuerpo: 14-16sp | Etiquetas secundarias: 12-13sp
         NOTA: parent="" es OBLIGATORIO. Sin eso, Android intenta heredar
         automáticamente de un estilo llamado "Texto" (todo lo que está
         antes del último punto), que no existe, y el build truena. -->
    <style name="Texto.Titulo" parent="">
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Texto.Subtitulo" parent="">
        <item name="android:textColor">@color/color_texto_secundario</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Texto.Etiqueta" parent="">
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Texto.EtiquetaOjo" parent="">
        <item name="android:textColor">@color/color_accion</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ======================= BOTONES ======================================
         Regla del PDF: acciones principales de 52dp de alto (mínimo táctil
         nativo: 44pt iOS / 48dp Android). Bordes redondeados, responsivos.
         Aquí SÍ tienen parent real (MaterialComponents.Button), así que
         no hay ambigüedad y no hace falta parent="". -->
    <style name="Boton.Principal" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/color_accion</item>
        <item name="android:textColor">@color/color_blanco</item>
        <item name="rippleColor">@color/color_apoyo</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botón secundario (fondo "apoyo", texto "confianza") usado en
         "Cerrar sesión" y "Explorar el catálogo" -->
    <style name="Boton.Secundario" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/color_apoyo</item>
        <item name="android:textColor">@color/color_confianza</item>
        <item name="rippleColor">@color/color_confianza</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Campos de texto (usuario / contraseña) -->
    <style name="CampoTexto" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/color_confianza</item>
        <item name="hintTextColor">@color/color_texto_secundario</item>
        <item name="android:textColorHint">@color/color_texto_secundario</item>
        <item name="endIconTint">@color/color_texto_secundario</item>
    </style>
</resources>