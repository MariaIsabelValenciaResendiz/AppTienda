<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/fondo_tarjeta_blanca"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imagenProductoItem"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/fondo_tarjeta_redondeada"
            android:contentDescription="@null"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoTituloItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/nova_texto"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Audífonos Aura" />

            <TextView
                android:id="@+id/textoPrecioUnitarioItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nova_texto_secundario"
                android:textSize="12sp"
                tools:text="$899.00 / unidad" />

            <TextView
                android:id="@+id/textoSubtotalItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/nova_texto"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="$899.00" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/botonEliminarItem"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descripcion_eliminar"
            android:src="@drawable/ic_eliminar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/botonRestarItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/fondo_circulo_boton"
            android:contentDescription="@string/descripcion_restar"
            android:src="@drawable/ic_quitar" />

        <TextView
            android:id="@+id/textoCantidadItem"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/nova_texto"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1" />

        <ImageButton
            android:id="@+id/botonSumarItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/fondo_circulo_boton"
            android:contentDescription="@string/descripcion_sumar"
            android:src="@drawable/ic_agregar" />
    </LinearLayout>
</LinearLayout>
