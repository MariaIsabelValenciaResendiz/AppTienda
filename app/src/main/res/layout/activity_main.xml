<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF6EF"
    tools:context=".MainActivity">

    <!-- ===== SECCIÓN SUPERIOR FIJA: header + banner + fila de catálogo ===== -->
    <LinearLayout
        android:id="@+id/llTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header: nova + subtítulo + chip de rol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nova•"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1E5B3A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Algo nuevo para ti"
                    android:textSize="12sp"
                    android:textColor="#888888" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtRolUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCEEE3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Cliente"
                android:textSize="12sp"
                android:textColor="#1E5B3A" />

        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevoProducto"
            style="@style/Widget.Nova.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/new_product"
            android:text="@string/new_product"
            android:visibility="gone"
            app:icon="@drawable/icono_agregar"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_small" />
        <!-- Banner promocional -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F7D9CE"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TU PRÓXIMO FAVORITO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5C4033"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estrena algo.\nSonríe más."
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Descubre algo que va contigo."
                android:textSize="13sp"
                android:textColor="#555555" />

        </LinearLayout>

        <!-- Fila SIN filtro: Explora el catálogo + botón Categorías -->
        <LinearLayout
            android:id="@+id/rowSinFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Explora el catálogo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/btnCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="☰ Categorías"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Fila CON filtro: nombre de categoría + botón Cambiar (oculta por defecto) -->
        <LinearLayout
            android:id="@+id/rowConFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtCategoriaActiva"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Electrónica"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/btnCambiarCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="☰ Cambiar"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Fila de contador + Ver todos (oculta por defecto) -->
        <LinearLayout
            android:id="@+id/rowContador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtContadorResultados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1 resultado"
                android:textSize="13sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/txtVerTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver todos"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E5B3A"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===== RecyclerView: cuadrícula de productos ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/llTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llBottomNav"
        tools:listitem="@layout/item_producto" />

    <!-- ===== Indicador de carga (Escenario 2) ===== -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llTop"
        app:layout_constraintBottom_toTopOf="@id/llBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Vista de error (Escenario 3) ===== -->
    <LinearLayout
        android:id="@+id/llError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llTop"
        app:layout_constraintBottom_toTopOf="@id/llBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se pudo cargar el catálogo."
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnReintentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E5B3A"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Reintentar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ===== Navegación inferior ===== -->
    <LinearLayout
        android:id="@+id/llBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnExplorar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Explorar"
            android:textStyle="bold"
            android:textColor="#1E5B3A" />

        <TextView
            android:id="@+id/btnCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Carrito"
            android:textColor="#999999" />

        <TextView
            android:id="@+id/btnMiCuenta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mi cuenta"
            android:textColor="#999999" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>