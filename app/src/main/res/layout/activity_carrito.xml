<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_fondo">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/encabezadoCarrito"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/botonRegresarCarrito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_circulo_boton"
            android:contentDescription="@string/descripcion_regresar"
            android:src="@drawable/ic_flecha_atras" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/titulo_mi_carrito"
            android:textColor="@color/nova_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoCantidadArticulos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/nova_texto_secundario"
            android:textSize="13sp"
            tools:text="2 artículos" />
    </LinearLayout>

    <!-- Estado: carrito CON productos -->
    <LinearLayout
        android:id="@+id/vistaCarritoConProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezadoCarrito">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCarrito"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_articulo_carrito" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nova_blanco"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/etiqueta_total"
                    android:textColor="@color/nova_texto_secundario"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textoTotalProductos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nova_texto"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="$1,548.00" />
            </LinearLayout>

            <Button
                android:id="@+id/botonProcederPago"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/fondo_boton_primario"
                android:text="@string/accion_proceder_pago"
                android:textAllCaps="false"
                android:textColor="@color/nova_blanco"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Estado: carrito VACÍO (Escenario 3 de US10) -->
    <LinearLayout
        android:id="@+id/vistaCarritoVacio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezadoCarrito"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_carrito" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mensaje_carrito_vacio_titulo"
            android:textColor="@color/nova_texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/mensaje_carrito_vacio_subtitulo"
            android:textColor="@color/nova_texto_secundario"
            android:textSize="14sp" />

        <Button
            android:id="@+id/botonExplorarCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/fondo_boton_secundario"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/accion_explorar_catalogo"
            android:textAllCaps="false"
            android:textColor="@color/nova_confianza"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
